{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "bun"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "demo/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ]
}
