{
  "name": "@pksep/manager-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "demo": "bun run demo/start.ts",
    "dev": "vite --host 127.0.0.1 --port 4310 --strictPort",
    "demo:server": "bun --watch demo/server.ts",
    "typecheck": "vue-tsc --noEmit",
    "build": "bun run typecheck && vite build && vite build --config vite.loader.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4312 --strictPort",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "format": "prettier --write src demo tests *.ts *.json *.html"
  },
  "dependencies": {
    "@pksep/yui": "0.1.318",
    "dompurify": "3.4.14",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bun": "1.3.9",
    "@types/node": "25.0.6",
    "@vitejs/plugin-vue": "6.0.3",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vue-tsc": "2.2.12"
  }
}
